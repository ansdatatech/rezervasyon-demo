---
import Layout from '../layouts/Layout.astro';
import { decodeJwt } from 'jose';

const token = Astro.cookies.get('auth_token')?.value;

if (!token) {
    return Astro.redirect('/');
}

// Güvenlik: Sadece YÖNETİCİ girebilir
try {
    const decoded = decodeJwt(token);
    if (decoded.rol !== 'yonetici') {
        return Astro.redirect('/');
    }
} catch (error) {
    return Astro.redirect('/');
}
---

<Layout title="Ayarlar ve Personel | Kort Rezervasyon">

    <div class="bg-dark text-white p-2 d-flex justify-content-between align-items-center" style="border-bottom: 3px solid var(--accent-green);">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="fa-solid fa-gear text-secondary me-2"></i> SİSTEM AYARLARI VE YETKİLENDİRME</span>
            <a href="/" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-arrow-left me-1"></i> Panele Dön</a>
        </div>
    </div>

    <div class="container mt-5">
        <div class="row">
            
            <!-- SOL SÜTUN -->
            <div class="col-md-4 mb-4">
                
                <!-- 1. YENİ PERSONEL EKLEME FORMU -->
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="fw-bold text-secondary"><i class="fa-solid fa-user-plus me-2"></i>Yeni Hesap Ekle</h5>
                    </div>
                    <div class="card-body">
                        <form id="personelFormu">
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Yetki Rolü</label>
                                <select id="pRol" class="form-select border-secondary fw-bold text-dark">
                                    <option value="sekreter">Sekreter (Ön Büro / Takvim Yönetimi)</option>
                                    <option value="antrenor">Antrenör / Uzman (Sadece Kendi Seansları)</option>
                                    <option value="yonetici">Yönetici (Tam Yetki)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Kullanıcı Adı (Sisteme Giriş İçin)</label>
                                <input type="text" id="pKullaniciAdi" class="form-control" placeholder="Örn: ahmet_hoca" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Görünür İsim (Ad Soyad)</label>
                                <input type="text" id="pAdSoyad" class="form-control" placeholder="Örn: Ahmet Yılmaz" required>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold small text-muted">Geçici Şifre</label>
                                <input type="password" id="pSifre" class="form-control" placeholder="En az 6 karakter" required minlength="6">
                            </div>
                            <button type="submit" id="pKaydetBtn" class="btn btn-primary w-100 fw-bold shadow-sm py-2">HESAP OLUŞTUR</button>
                        </form>
                    </div>
                </div>

                <!-- 2. ÇALIŞMA SAATLERİ AYARI -->
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="fw-bold text-secondary"><i class="fa-solid fa-clock me-2"></i>Çalışma Saatleri</h5>
                    </div>
                    <div class="card-body">
                        <form id="saatAyarlariFormu">
                            <input type="hidden" id="ayarId">
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold small text-muted">Açılış Saati</label>
                                    <input type="number" id="baslangicSaati" class="form-control fw-bold" min="0" max="23" required>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold small text-muted">Kapanış Saati</label>
                                    <input type="number" id="bitisSaati" class="form-control fw-bold" min="1" max="24" required>
                                </div>
                            </div>
                            <button type="submit" id="saatKaydetBtn" class="btn btn-warning w-100 fw-bold shadow-sm py-2">
                                <i class="fa-solid fa-save me-2"></i>SAATLERİ KAYDET
                            </button>
                        </form>
                    </div>
                </div>

            </div>

            <!-- SAĞ SÜTUN: MEVCUT PERSONELLER TABLOSU -->
            <div class="col-md-8 mb-4">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="fw-bold text-secondary"><i class="fa-solid fa-users-gear me-2"></i>Sistem Kullanıcıları</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>İsim Soyisim</th>
                                        <th>Kullanıcı Adı</th>
                                        <th>Rol / Yetki</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody id="personelTabloGövdesi">
                                    <tr><td colspan="4" class="text-center py-4 text-muted"><i class="fa-solid fa-spinner fa-spin me-2"></i> Yükleniyor...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- YÖNETİCİ ŞİFRE SIFIRLAMA MODALI -->
    <div class="modal fade" id="adminSifreModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header bg-warning rounded-top-4">
                    <h6 class="modal-title fw-bold text-dark"><i class="fa-solid fa-unlock-keyhole me-2"></i>Şifre Sıfırla</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3"><strong><span id="sifirlanacakKisi"></span></strong> adlı kullanıcının şifresini yeniliyorsunuz.</p>
                    <form id="adminSifreFormu">
                        <input type="hidden" id="sifirlanacakId">
                        <div class="mb-3">
                            <input type="password" id="yeniSifreAdmin" class="form-control" placeholder="Yeni Şifre Belirleyin" required minlength="6">
                        </div>
                        <button type="submit" id="adminSifreKaydetBtn" class="btn btn-dark w-100 fw-bold">ŞİFREYİ GÜNCELLE</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</Layout>

<script is:inline>
    document.addEventListener("DOMContentLoaded", function() {
        personelleriGetir();
        ayarlariGetir(); // Sayfa açılınca çalışma saatlerini çek

        // PERSONEL EKLEME İŞLEMİ
        document.getElementById('personelFormu').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('pKaydetBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> OLUŞTURULUYOR...';

            try {
                const response = await fetch('/api/kullanici', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        rol: document.getElementById('pRol').value,
                        kullaniciAdi: document.getElementById('pKullaniciAdi').value,
                        adSoyad: document.getElementById('pAdSoyad').value,
                        sifre: document.getElementById('pSifre').value
                    })
                });

                if (response.ok) {
                    document.getElementById('personelFormu').reset();
                    personelleriGetir();
                    alert("Hesap başarıyla oluşturuldu!");
                } else {
                    const data = await response.json();
                    alert(data.error || "Hata oluştu.");
                }
            } catch (err) {
                alert("Sunucuya ulaşılamadı.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'HESAP OLUŞTUR';
            }
        });

        // YÖNETİCİ ŞİFRE SIFIRLAMA İŞLEMİ
        document.getElementById('adminSifreFormu').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('adminSifreKaydetBtn');
            btn.innerHTML = 'BEKLEYİN...'; btn.disabled = true;
            
            try {
                const res = await fetch('/api/kullanici', {
                    method: 'PUT', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        id: document.getElementById('sifirlanacakId').value,
                        yeniSifre: document.getElementById('yeniSifreAdmin').value
                    })
                });
                
                if(res.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('adminSifreModal')).hide();
                    alert("Kullanıcının şifresi başarıyla sıfırlandı!");
                } else {
                    alert("Hata oluştu. Sadece yöneticiler şifre sıfırlayabilir.");
                }
            } catch(err) { 
                alert("Sunucu hatası."); 
            } finally { 
                btn.innerHTML = 'ŞİFREYİ GÜNCELLE'; 
                btn.disabled = false; 
            }
        });

        // ÇALIŞMA SAATLERİNİ KAYDETME İŞLEMİ
        document.getElementById('saatAyarlariFormu').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('saatKaydetBtn');
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>KAYDEDİLİYOR...'; 
            btn.disabled = true;
            
            try {
                const res = await fetch('/api/ayarlar-api', {
                    method: 'PUT', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        id: document.getElementById('ayarId').value,
                        baslangicSaati: document.getElementById('baslangicSaati').value,
                        bitisSaati: document.getElementById('bitisSaati').value
                    })
                });
                if(res.ok) {
                    alert("Saatler güncellendi! Ana sayfadaki takvim artık bu saatlere göre çizilecek.");
                } else alert("Hata oluştu.");
            } catch(err) { 
                alert("Sunucu hatası"); 
            } finally { 
                btn.innerHTML = '<i class="fa-solid fa-save me-2"></i>SAATLERİ KAYDET'; 
                btn.disabled = false; 
            }
        });
    });

    // AYARLARI GETİRME FONKSİYONU
    async function ayarlariGetir() {
        try {
            const res = await fetch('/api/ayarlar-api');
            if(res.ok) {
                const data = await res.json();
                document.getElementById('ayarId').value = data.id;
                document.getElementById('baslangicSaati').value = data.baslangicSaati;
                document.getElementById('bitisSaati').value = data.bitisSaati;
            }
        } catch (err) { console.error("Ayarlar çekilemedi."); }
    }

    async function personelleriGetir() {
        const tbody = document.getElementById('personelTabloGövdesi');
        try {
            const response = await fetch('/api/kullanici');
            const kullanicilar = await response.json();
            
            tbody.innerHTML = '';
            
            kullanicilar.forEach(k => {
                let rolBadge = '';
                if (k.rol === 'yonetici') rolBadge = '<span class="badge bg-danger">Yönetici</span>';
                else if (k.rol === 'sekreter') rolBadge = '<span class="badge bg-info text-dark">Sekreter</span>';
                else rolBadge = '<span class="badge bg-success">Antrenör / Uzman</span>';

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="fw-bold">${k.adSoyad}</td>
                    <td class="text-muted">@${k.kullaniciAdi}</td>
                    <td>${rolBadge}</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-warning me-1 shadow-sm" onclick="sifreSifirlaModalAc(${k.id}, '${k.adSoyad}')" title="Şifreyi Sıfırla">
                            <i class="fa-solid fa-key"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger shadow-sm" onclick="personelSil(${k.id}, '${k.adSoyad}')" title="Kullanıcıyı Sil">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        } catch (err) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Bağlantı hatası!</td></tr>';
        }
    }

    window.sifreSifirlaModalAc = function(id, adSoyad) {
        document.getElementById('sifirlanacakId').value = id;
        document.getElementById('sifirlanacakKisi').innerText = adSoyad;
        document.getElementById('yeniSifreAdmin').value = '';
        new bootstrap.Modal(document.getElementById('adminSifreModal')).show();
    };

    window.personelSil = async function(id, adSoyad) {
        if(confirm(`${adSoyad} adlı kişinin sisteme giriş yetkisini iptal etmek istiyor musunuz?`)) {
            try {
                const response = await fetch(`/api/kullanici?id=${id}`, { method: 'DELETE' });
                if (response.ok) {
                    personelleriGetir();
                } else {
                    const data = await response.json();
                    alert(data.error || "Silinemedi.");
                }
            } catch(err) {
                alert("Hata oluştu.");
            }
        }
    }
</script>